# ---------------------------------------------------------------------------
# API (locale ou Render / Railway)
# ---------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Base SQLite. En production, pointez vers le disque persistant monté.
DB_PATH=./data/crm.db

# Mot de passe admin initial — uniquement avant la première création de la base.
# À définir dans le tableau de bord de l'hébergeur, jamais à committer.
CRM_ADMIN_PASSWORD=

# Origines du front autorisées à appeler l'API avec cookies (séparées par des virgules).
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Cookies cross-site (front Vercel -> API Render/Railway) : None + Secure.
# En local, laissez Lax / 0.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Front (Vercel) — à définir dans les variables d'environnement Vercel
# ---------------------------------------------------------------------------
# VITE_API_URL=https://asirem-api.onrender.com
