{
  "name": "bougie-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM et boutique dynamique pour un artisan bougier — Node.js, React, SQLite",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node --watch server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "reset-db": "node server/init.js --reset"
  },
  "dependencies": {
    "express": "^4.21.2",
    "konva": "^10.10.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.3.6"
  }
}
